  {
    "id": "i-wandered-through-the-sea",
    "title": "I Wandered Through the Sea",
    "stanzas": [
      [
        {
          "text": "I wandered through the sea,",
          "italic": false,
          "indent": 0
        },
        {
          "text": "the sun waylaying",
          "italic": false,
          "indent": 0
        },
        {
          "text": "at the edge of the world,",
          "italic": false,
          "indent": 0
        },
        {
          "text": "as it said goodnight",
          "italic": false,
          "indent": 0
        },
        {
          "text": "and laid its head to sleep.",
          "italic": false,
          "indent": 0
        }
      ],
      [
        {
          "text": "I journeyed through the waves",
          "italic": false,
          "indent": 0
        },
        {
          "text": "as the moon lit up the path,",
          "italic": false,
          "indent": 0
        },
        {
          "text": "as if it knew",
          "italic": false,
          "indent": 0
        },
        {
          "text": "the voyage I had taken on,",
          "italic": false,
          "indent": 0
        },
        {
          "text": "and where I’d be drawn",
          "italic": false,
          "indent": 0
        }
      ],
      [
        {
          "text": "With fragments of the sun",
          "italic": false,
          "indent": 0
        },
        {
          "text": "so gently borrowed,",
          "italic": false,
          "indent": 0
        },
        {
          "text": "half her face, innocent",
          "italic": false,
          "indent": 0
        },
        {
          "text": "and almost sly,",
          "italic": false,
          "indent": 0
        },
        {
          "text": "hid behind",
          "italic": false,
          "indent": 0
